# Kanalnamn som visas i videons logga och kan nämnas i avslutningen
CHANNEL_NAME=My Channel

# Claude (manus, scenplanering). Hämta nyckel: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ElevenLabs TTS. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Röst-ID från ElevenLabs Voice Library (standard: George)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Pexels (gratis, licensfria bilder). https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube-uppladdning (valfritt). Se "YouTube-uppladdning" i README för hur du skapar dessa.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Telegram-notiser med Stopp-knapp för nyhetsbevakaren (valfritt). Skapa en bot hos @BotFather och klistra in token.
# Skicka sedan /start till boten: den svarar med ditt chat-id, som du lägger i TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
