# Channel name shown in the video logo; may be mentioned in the outro
CHANNEL_NAME=My Channel

# Claude (script, scene planning). Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ElevenLabs TTS. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID from the ElevenLabs Voice Library (default: George)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Pexels (free, royalty-free images). https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube upload (optional). See "YouTube upload" in the README for how to create these.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Telegram notifications with a Stop button for the news watcher (optional). Create a bot with @BotFather and paste the token.
# Then send /start to the bot: it replies with your chat id, which goes in TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Arqen Motion (animated numbers, quotes, timelines, comparisons). Defaults to a sibling folder "Arqen Motion".
MOTION_DIR=
